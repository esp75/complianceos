# Copy to .env (never commit .env). Everything here is optional.

# Database password for the local Postgres container.
POSTGRES_PASSWORD=local-dev-only

# Signs exported dossier PDFs with an Ed25519 key derived from this seed.
# Generate one with:  openssl rand -hex 32
# Leave empty and dossiers are exported unsigned (and say so).
TRUST_SIGNING_SEED=

# Lets Claude rewrite the brief's executive summary. Its text must cite the law the roadmap already
# cites, or it is rejected. Leave empty to keep the brief fully deterministic.
ANTHROPIC_API_KEY=

# Public repository URL, used for "suggest a correction" links in the web app.
REPO_URL=

# The Watch emails a digest when a cited source changes. Off until SMTP_HOST and ALERT_FROM are set.
# Use an EU-hosted relay. Each workspace sets its own recipients on the Workspace page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
ALERT_FROM=
ALERT_RECIPIENTS=
PUBLIC_WEB_URL=http://localhost:3000
# Seconds between Watch runs (default one day).
WATCH_INTERVAL_SECONDS=86400
